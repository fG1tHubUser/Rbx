--============================================================
-- STATE & CHAIN DATA
--============================================================
local gameList = {}
local listLoaded = false
local listLoadedEvent = Instance.new("BindableEvent")

local function loadGameList()
	local success, body = pcall(function()
		return HttpService:GetAsync(CHAIN_URL, true)
	end)

	if not success or type(body) ~= "string" then
		warn("[BadgeChain] Failed to load ID-Index: " .. tostring(body))
		listLoaded = true
		listLoadedEvent:Fire()
		return
	end

	for line in body:gmatch("[^\r\n]+") do
		line = line:match("^%s*(.-)%s*$")

		if line ~= "" and not line:match("^#") then
			local universeStr, placeStr = line:match("^(%d+)%s*,%s*(%d+)$")

			if universeStr and placeStr then
				table.insert(gameList, {
					universeId = tonumber(universeStr),
					placeId = tonumber(placeStr)
				})
			end
		end
	end

	if #gameList == 0 then
		warn("[BadgeChain] ID-Index loaded, but no valid game entries were found.")
	end

	listLoaded = true
	listLoadedEvent:Fire()
end

-- Load the list independently. The player GUI does not wait for this request.
task.spawn(loadGameList)

--============================================================
-- FETCH ALL BADGES FOR AN EXPERIENCE
--============================================================
local function fetchBadgesForUniverse(universeId)
	local all = {}
	local cursor = nil
	local pages = 0

	while true do
		pages += 1

		local cursorParam = cursor
			and ("&cursor=" .. HttpService:UrlEncode(cursor))
			or ""

		local url = string.format(
			"https://badges.roproxy.com/v1/universes/%d/badges?limit=100&sortOrder=Asc%s",
			universeId,
			cursorParam
		)

		local success, response = pcall(function()
			return HttpService:GetAsync(url, true)
		end)

		-- Fall back to Roblox's endpoint if the proxy fails.
		if not success then
			url = string.format(
				"https://badges.roblox.com/v1/universes/%d/badges?limit=100&sortOrder=Asc%s",
				universeId,
				cursorParam
			)

			success, response = pcall(function()
				return HttpService:GetAsync(url, true)
			end)
		end

		if not success then
			warn(
				"[BadgeChain] Failed to fetch badges for universe "
					.. tostring(universeId)
					.. ": "
					.. tostring(response)
			)
			return nil
		end

		local decodeSuccess, data = pcall(function()
			return HttpService:JSONDecode(response)
		end)

		-- Do not mistake an unexpected API response for a completed badge list.
		if not decodeSuccess
			or type(data) ~= "table"
			or type(data.data) ~= "table" then

			warn(
				"[BadgeChain] Invalid badge-list response for universe "
					.. tostring(universeId)
			)
			return nil
		end

		for _, badge in ipairs(data.data) do
			if badge.id and badge.enabled ~= false then
				table.insert(all, {
					id = badge.id
				})
			end
		end

		cursor = data.nextPageCursor

		if not cursor or cursor == "" or pages > 40 then
			break
		end

		-- Keep light pacing between paginated HTTP requests.
		task.wait(0.08)
	end

	-- Never treat a failed/empty response as proof that an experience is done.
	if #all == 0 then
		warn(
			"[BadgeChain] Zero badges returned for universe "
				.. tostring(universeId)
				.. "; refusing to skip this experience."
		)
		return nil
	end

	return all
end

--============================================================
-- RATE-LIMIT DETECTION
--============================================================
local function isRateLimitError(err)
	local lower = string.lower(tostring(err))

	for _, keyword in ipairs(RATE_LIMIT_KEYWORDS) do
		if string.find(lower, keyword, 1, true) then
			return true
		end
	end

	return false
end

