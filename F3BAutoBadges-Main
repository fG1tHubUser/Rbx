--============================================================

setPhase = function(gui, statusStr, infoStr)
	if gui and gui.statusText and gui.currentStateInfo then
		gui.statusText.Text = statusStr
		gui.currentStateInfo.Text = infoStr
	end
end

updateProgress = function(gui, owned, total)
	if not gui then return end

	local alpha = 0
	if total > 0 then
		alpha = math.clamp(owned / total, 0, 1)
	end

	TweenService:Create(
		gui.barFill,
		TWEEN_BAR,
		{ Size = UDim2.new(MAX_BAR_WIDTH * alpha, 0, BAR_HEIGHT, 0) }
	):Play()

	gui.awardedOfTotal.Text = string.format("%d / %d", owned, total)
	gui.remainingBadges.Text = string.format("%d Remaining", math.max(total - owned, 0))
end

