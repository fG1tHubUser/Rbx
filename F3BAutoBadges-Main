local function awardOneBadge(player, badgeId)
	local lastError = nil

	for attempt = 1, MAX_FAILED_ATTEMPTS do
		if not player or not player.Parent then
			return false, "LEFT"
		end

		local callOk, awardResult = pcall(function()
			return BadgeService:AwardBadgeAsync(player.UserId, badgeId)
		end)

		if callOk and awardResult == true then
			return true, nil
		elseif not callOk then
			lastError = awardResult
			warn(string.format("[BadgeChain] Award error for badge %s (Attempt %d): %s", tostring(badgeId), attempt, tostring(awardResult)))
			
			if isRateLimitError(awardResult) then
				return nil, "RATE_LIMIT"
			end
		end

		task.wait(0.5 * attempt)
	end

	return nil, "ERROR"
end

--============================================================
-- MAIN FLOW
--============================================================

local function processPlayer(player)
	while not listLoaded do task.wait(0.5) end

	local gui = createGui(player)
	if not gui then return end

	setPhase(gui, "Waiting...", "Loading data...")

	local currentUniverse = game.GameId
	local currentPlace = game.PlaceId
	local currentIndex = nil

	for i, entry in ipairs(gameList) do
		if entry.universeId == currentUniverse then
			currentIndex = i
			break
		end
	end

	local nextPlaceId = (currentIndex and currentIndex < #gameList) and gameList[currentIndex + 1].placeId or nil

	gui.gameTracker.Text = string.format("Game %d of %d", currentIndex or 1, #gameList > 0 and #gameList or 1)

	local joinData = player:GetJoinData()
	local teleportData = joinData and joinData.TeleportData or {}
	local alreadyAwarded = {}

	if teleportData and teleportData.awardedIds then
		for _, id in ipairs(teleportData.awardedIds) do
			alreadyAwarded[tostring(id)] = true
		end
	end

	setPhase(gui, "Loading badges...", "Loading data...")
	local badges = fetchBadgesForUniverse(currentUniverse)

	if not badges then
		setPhase(gui, "Error", "Failed to load badges. Rejoin.")
		return
	end

	local toAward = {}
	local ownedCount = 0
	local total = #badges

	setPhase(gui, "Checking badges...", "Syncing inventory...")

	--========================================================
	-- NATIVE ROBLOX OWNERSHIP SWEEP (SILENT)
	--========================================================
	for i, badge in ipairs(badges) do
		if alreadyAwarded[tostring(badge.id)] then
			ownedCount += 1
		else
			local success, hasBadge = false, false
			local retries = 0
			
			-- Retries safely if Roblox drops the read request
			while not success and retries < 5 do
				success, hasBadge = pcall(function()
					return BadgeService:UserHasBadgeAsync(player.UserId, badge.id)
				end)
				
				if not success then
					retries += 1
					task.wait(0.2)
				end
			end

			if success and hasBadge then
				ownedCount += 1
				alreadyAwarded[tostring(badge.id)] = true
			else
				table.insert(toAward, badge)
			end
		end
	end

	--========================================================
	-- INSTANT JUMP TO OWNED
	-- Bar instantly sets to current ownership (e.g. 110/110)
	--========================================================
	updateProgress(gui, ownedCount, total)
	
	-- IF ALREADY OWN EVERYTHING, INSTANTLY TELEPORT
	if #toAward == 0 then
		local completeSound = Instance.new("Sound")
		completeSound.SoundId = "rbxassetid://107978604605265"
		completeSound.Volume = 0.69
		completeSound.PlaybackSpeed = 0.5
		completeSound.Parent = gui.screen
		completeSound:Play()

		if nextPlaceId then
			setPhase(gui, "Awarded all badges in this game!", "Teleporting to the next...")
			task.wait(2)
			while player.Parent do
				local teleported = teleportToNextGame(player, nextPlaceId)
				if teleported then return end
				task.wait(2.5)
			end
		else
			setPhase(gui, "Come back tomorrow for more badges!", "Chain complete!")
			gui.remainingBadges.Text = "All badges awarded in every game!"
		end
		return
	end

	task.wait(0.5)

	--========================================================
	-- AWARD LOOP (ONLY UNOWNED BADGES)
	--========================================================
	local awardsThisServer = 0

	for _, badge in ipairs(toAward) do
		if not player.Parent then return end

		if awardsThisServer >= AWARDS_PER_SERVER then
			local teleported = teleportToNewServer(player, currentPlace, alreadyAwarded, gui, string.format("%d badges awarded. Starting a new server...", AWARDS_PER_SERVER))
			if teleported then return end

			task.wait(2)
			local retryTeleport = teleportToNewServer(player, currentPlace, alreadyAwarded, gui, "Retrying...")
			if retryTeleport then return end
			
			task.wait(3)
			continue
		end

		local status, err = awardOneBadge(player, badge.id)

		if status == true then
			ownedCount += 1
			awardsThisServer += 1
			alreadyAwarded[tostring(badge.id)] = true

			setPhase(gui, "Awarding badges...", string.format("Awarded Badge: %s", tostring(badge.id)))
			updateProgress(gui, ownedCount, total)

			if awardsThisServer >= AWARDS_PER_SERVER then
				task.wait(0.2)
				local teleported = teleportToNewServer(player, currentPlace, alreadyAwarded, gui, "Moving to a new server...")
				if teleported then return end

				while player.Parent do
					task.wait(2)
					local retry = teleportToNewServer(player, currentPlace, alreadyAwarded, gui, "Retrying teleport...")
					if retry then return end
				end
				return
			end
			
			task.wait(AWARD_DELAY)
			
		elseif status == nil then
			if err == "RATE_LIMIT" then
				setPhase(gui, "Rate Limited", "Pausing 60s for API reset...")
				task.wait(60)
			end
		end
	end

	--========================================================
	-- ALL BADGES IN CURRENT GAME COMPLETE
	--========================================================
	updateProgress(gui, total, total)

	local completeSound = Instance.new("Sound")
	completeSound.SoundId = "rbxassetid://107978604605265"
	completeSound.Volume = 0.69
	completeSound.PlaybackSpeed = 0.5
	completeSound.Parent = gui.screen
	completeSound:Play()

	if nextPlaceId then
		setPhase(gui, "Awarded all badges in this game!", "Teleporting to the next...")
		task.wait(2)

		while player.Parent do
			local teleported = teleportToNextGame(player, nextPlaceId)
			if teleported then return end
			task.wait(2.5)
		end
	else
		setPhase(gui, "Come back tomorrow for more badges!", "Chain complete!")
		gui.remainingBadges.Text = "All badges awarded in every game!"
	end
end

--============================================================
-- PLAYER CONNECTIONS
--============================================================

Players.PlayerAdded:Connect(function(player)
	task.spawn(processPlayer, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(processPlayer, player)
end
