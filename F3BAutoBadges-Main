--============================================================
-- UI HELPERS
--============================================================
local function setPhase(gui, statusStr, infoStr)
	if gui and gui.statusText and gui.currentStateInfo then
		gui.statusText.Text = statusStr
		gui.currentStateInfo.Text = infoStr
	end
end

local function updateProgress(gui, owned, total)
	if not gui then
		return
	end

	local alpha = (total > 0)
		and math.clamp(owned / total, 0, 1)
		or 0

	TweenService:Create(
		gui.barFill,
		TWEEN_BAR,
		{
			Size = UDim2.new(
				MAX_BAR_WIDTH * alpha,
				0,
				BAR_HEIGHT,
				0
			)
		}
	):Play()

	gui.awardedOfTotal.Text = string.format("%d / %d", owned, total)
	gui.remainingBadges.Text = string.format("%d Remaining", math.max(0, total - owned))
end

--============================================================
-- MAIN FLOW
--============================================================
local function processPlayer(player)
	if not player.Parent then
		return
	end

	-- Display the GUI immediately, before downloading the index or badges.
	local gui = createGui(player)
	if not gui then
		warn("[BadgeChain] Could not create the GUI for " .. player.Name)
		return
	end

	setPhase(gui, "Waiting...", "Loading game data...")

	-- Wait for the ID-Index only after the GUI is already visible.
	if not listLoaded then
		listLoadedEvent.Event:Wait()
	end

	if not player.Parent then
		return
	end

	if #gameList == 0 then
		setPhase(gui, "Error", "The game index failed to load.")
		return
	end

	local currentUniverse = game.GameId
	local currentPlace = game.PlaceId
	local currentIndex = nil

	for i, entry in ipairs(gameList) do
		if entry.universeId == currentUniverse then
			currentIndex = i
			break
		end
	end

	if not currentIndex then
		setPhase(gui, "Error:", "This game was not found in the index!")
		warn("[BadgeChain] Current universe " .. tostring(currentUniverse) .. " is missing from ID-Index.")
		return
	end

	local nextPlaceId = currentIndex < #gameList
		and gameList[currentIndex + 1].placeId
		or nil

	gui.gameTracker.Text = string.format(
		"Game %d of %d",
		currentIndex,
		#gameList
	)

	local dsKey = "User_" .. player.UserId .. "_Universe_" .. currentUniverse
	local alreadyAwarded = {}

	-- Recover from TeleportData.
	local joinData = player:GetJoinData()
	local teleportData = joinData and joinData.TeleportData or {}

	if type(teleportData.awardedIds) == "table" then
		for _, id in ipairs(teleportData.awardedIds) do
			alreadyAwarded[tostring(id)] = true
		end
	end

	-- Load the permanent cache.
	local dsSuccess, dsData = pcall(function()
		return BadgeCache:GetAsync(dsKey)
	end)

	if dsSuccess and type(dsData) == "table" then
		for _, id in ipairs(dsData) do
			alreadyAwarded[tostring(id)] = true
		end
	elseif not dsSuccess then
		warn("[BadgeChain] Cache read failed: " .. tostring(dsData))
	end

	local function saveCache()
		local toSave = {}

		for id in pairs(alreadyAwarded) do
			local numericId = tonumber(id)
			if numericId then
				table.insert(toSave, numericId)
			end
		end

		local success, err = pcall(function()
			BadgeCache:SetAsync(dsKey, toSave)
		end)

		if not success then
			warn("[BadgeChain] Cache save failed: " .. tostring(err))
		end
	end

	--========================================================
	-- LOAD BADGES
	--========================================================
	setPhase(gui, "Loading badges...", "Fetching badge data...")

	local badges = fetchBadgesForUniverse(currentUniverse)

	if not badges then
		-- Stop here rather than accidentally skipping to the next experience.
		setPhase(gui, "Error", "Badge loading failed. Staying on this game.")
		return
	end

	--========================================================
	-- CHECK OWNERSHIP IN BATCHES OF UP TO 100
	--========================================================
	local toAward = {}
	local ownedCount = 0
	local total = #badges
	local unchecked = {}

	for _, badge in ipairs(badges) do
		if alreadyAwarded[tostring(badge.id)] then
			ownedCount += 1
		else
			table.insert(unchecked, badge)
		end
	end

	setPhase(gui, "Checking badges...", "Syncing inventory...")
	updateProgress(gui, ownedCount, total)

	for firstIndex = 1, #unchecked, BADGE_CHECK_BATCH_SIZE do
		if not player.Parent then
			return
		end

		local batchBadges = {}
		local badgeIds = {}
		local lastIndex = math.min(
			firstIndex + BADGE_CHECK_BATCH_SIZE - 1,
			#unchecked
		)

		for i = firstIndex, lastIndex do
			table.insert(batchBadges, unchecked[i])
			table.insert(badgeIds, unchecked[i].id)
		end

		local ownedInBatch = {}
		local checkSuccess, result = pcall(function()
			return BadgeService:GetUserBadgesAsync(
				player.UserId,
				badgeIds
			)
		end)

		if checkSuccess and type(result) == "table" then
			for _, ownedBadge in ipairs(result) do
				if ownedBadge.BadgeId then
					ownedInBatch[tostring(ownedBadge.BadgeId)] = true
				end
			end
		else
			warn(
				"[BadgeChain] Batch check failed; falling back to individual checks: "
					.. tostring(result)
			)

			for _, badge in ipairs(batchBadges) do
				if not player.Parent then
					return
				end

				local ok, hasBadge = pcall(function()
					return BadgeService:UserHasBadgeAsync(
						player.UserId,
						badge.id
					)
				end)

				if ok and hasBadge then
					ownedInBatch[tostring(badge.id)] = true
				elseif not ok then
					warn(
						"[BadgeChain] Ownership check failed for badge "
							.. tostring(badge.id)
							.. ": "
							.. tostring(hasBadge)
					)
				end
			end
		end

		for _, badge in ipairs(batchBadges) do
			local key = tostring(badge.id)

			if ownedInBatch[key] then
				if not alreadyAwarded[key] then
					alreadyAwarded[key] = true
					ownedCount += 1
				end
			else
				table.insert(toAward, badge)
			end
		end

		updateProgress(gui, ownedCount, total)
	end

	--========================================================
	-- AWARD BADGES
	--========================================================
	local awardAttemptsThisServer = 0

	for index, badge in ipairs(toAward) do
		if not player.Parent then
			return
		end

		awardAttemptsThisServer += 1

		local success, result = pcall(function()
			return BadgeService:AwardBadgeAsync(
				player.UserId,
				badge.id
			)
		end)

		if success and result == true then
			ownedCount += 1
			alreadyAwarded[tostring(badge.id)] = true

			setPhase(
				gui,
				"Awarding badges...",
				"Awarded Badge: " .. tostring(badge.id)
			)

		elseif success and result == false then
			-- Preserve the original script's handling of a false result.
			ownedCount += 1
			alreadyAwarded[tostring(badge.id)] = true

		else
			if isRateLimitError(result) then
				warn(
					"[BadgeChain] Rate limited while awarding badge "
						.. tostring(badge.id)
						.. ": "
						.. tostring(result)
				)
			else
				warn(
					"[BadgeChain] Error awarding badge "
						.. tostring(badge.id)
						.. ": "
						.. tostring(result)
				)
			end
		end

		-- Limit progress-bar work to every five badges.
		if ownedCount % 1 == 0 or index == #toAward then
			updateProgress(gui, ownedCount, total)
		end

		-- Keep the server request cap and save progress before hopping.
		if awardAttemptsThisServer >= AWARDS_PER_SERVER
			and index < #toAward then

			setPhase(
				gui,
				"Switching servers...",
				"Rate limit reached. Moving to a new server..."
			)

			saveCache()

			local teleportOptions = Instance.new("TeleportOptions")
			teleportOptions.ShouldReserveServer = true

			local saveData = {
				awardedIds = {},
				fromChain = true
			}

			for id in pairs(alreadyAwarded) do
				local numericId = tonumber(id)
				if numericId then
					table.insert(saveData.awardedIds, numericId)
				end
			end

			teleportOptions:SetTeleportData(saveData)

			while player.Parent do
				local teleportOk, teleportError = pcall(function()
					TeleportService:TeleportAsync(
						currentPlace,
						{ player },
						teleportOptions
					)
				end)

				if not teleportOk then
					warn("[BadgeChain] Server-hop teleport failed: " .. tostring(teleportError))
				end

				task.wait(2.5)
			end

			return
		end
	end

	-- Display the actual count, not an assumed 100%.
	updateProgress(gui, ownedCount, total)
	saveCache()

	--========================================================
	-- COMPLETION SOUND
	--========================================================
	local completeSound = Instance.new("Sound")
	completeSound.SoundId = "rbxassetid://107978604605265"
	completeSound.Volume = 0.69
	completeSound.PlaybackSpeed = 0.5
	completeSound.Parent = gui.screen
	completeSound:Play()

	--========================================================
	-- MOVE TO THE NEXT EXPERIENCE
	--========================================================
	if nextPlaceId then
		if ownedCount >= total then
			setPhase(
				gui,
				"Awarded all badges in this game!",
				"Teleporting to the next..."
			)
		else
			setPhase(
				gui,
				"Continuing chain...",
				string.format(
					"Warning: %d badges were not confirmed, please rejoin!",
					math.max(0, total - ownedCount)
				)
			)
		end

		local teleportOptions = Instance.new("TeleportOptions")
		teleportOptions:SetTeleportData({
			fromChain = true
		})

		while player.Parent do
			local teleportOk, teleportError = pcall(function()
				TeleportService:TeleportAsync(
					nextPlaceId,
					{ player },
					teleportOptions
				)
			end)

			if not teleportOk then
				warn("[BadgeChain] Next-game teleport failed: " .. tostring(teleportError))
			end

			task.wait(4.20)
		end
	else
		if ownedCount >= total then
			setPhase(
				gui,
				"Come back soon for more badges!",
				"Chain complete!"
			)

			gui.remainingBadges.Text = "Chain complete!"
		else
			setPhase(
				gui,
				"Chain ended with some failures...",
				string.format(
					"%d badges were not confirmed!",
					math.max(0, total - ownedCount)
				)
			)
		end
	end
end

--============================================================
-- PLAYER CONNECTIONS
--============================================================
Players.PlayerAdded:Connect(function(player)
	task.spawn(processPlayer, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(processPlayer, player)
end
