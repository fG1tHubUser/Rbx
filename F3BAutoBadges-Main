--============================================================
local function setPhase(gui, statusStr, infoStr)
	if gui and gui.statusText and gui.currentStateInfo then
		gui.statusText.Text = statusStr
		gui.currentStateInfo.Text = infoStr
	end
end

local function updateProgress(gui, owned, total)
	if not gui then
		return
	end

	local alpha = (total > 0)
		and math.clamp(owned / total, 0, 1)
		or 0

	TweenService:Create(
		gui.barFill,
		TWEEN_BAR,
		{
			Size = UDim2.new(
				MAX_BAR_WIDTH * alpha,
				0,
				BAR_HEIGHT,
				0
			)
		}
	):Play()

	gui.awardedOfTotal.Text = string.format("%d / %d", owned, total)
	gui.remainingBadges.Text = string.format("%d Remaining", math.max(0, total - owned))
end

--============================================================
-- DATASTORE CACHE HELPERS
--============================================================
local function loadCache(dsKey)
	local alreadyAwarded = {}

	local success, data = pcall(function()
		return BadgeCache:GetAsync(dsKey)
	end)

	if success and type(data) == "table" then
		for _, id in ipairs(data) do
			alreadyAwarded[tostring(id)] = true
		end
	elseif not success then
		warn("[BadgeChain] Cache read failed: " .. tostring(data))
	end

	return alreadyAwarded
end

local function saveCache(dsKey, alreadyAwarded)
	local toSave = {}

	for id in pairs(alreadyAwarded) do
		local numericId = tonumber(id)

		if numericId then
			table.insert(toSave, numericId)
		end
	end

	local success, err = pcall(function()
		BadgeCache:SetAsync(dsKey, toSave)
	end)

	if not success then
		warn("[BadgeChain] Cache save failed: " .. tostring(err))
	end

	return success
end

local function makeTeleportData(alreadyAwarded)
	local data = {
		awardedIds = {},
		fromChain = true
	}

	for id in pairs(alreadyAwarded) do
		local numericId = tonumber(id)

		if numericId then
			table.insert(data.awardedIds, numericId)
		end
	end

	return data
end

--============================================================
-- BATCH BADGE OWNERSHIP CHECK
--============================================================
local function checkBadgeBatch(player, badges, alreadyAwarded)
	local ownedInBatch = {}
	local badgeIds = {}

	for _, badge in ipairs(badges) do
		table.insert(badgeIds, badge.id)
	end

	local success, result = pcall(function()
		return BadgeService:GetUserBadgesAsync(
			player.UserId,
			badgeIds
		)
	end)

	if success and type(result) == "table" then
		for _, ownedBadge in ipairs(result) do
			if ownedBadge.BadgeId then
				ownedInBatch[tostring(ownedBadge.BadgeId)] = true
			end
		end

		return true, ownedInBatch
	end

	warn(
		"[BadgeChain] Batch ownership check failed; using individual checks: "
			.. tostring(result)
	)

	-- Compatibility fallback: check each badge individually.
	for _, badge in ipairs(badges) do
		if not player.Parent then
			return false, ownedInBatch
		end

		local checkSuccess, hasBadge = pcall(function()
			return BadgeService:UserHasBadgeAsync(
				player.UserId,
				badge.id
			)
		end)

		if checkSuccess and hasBadge then
			ownedInBatch[tostring(badge.id)] = true
		elseif not checkSuccess then
			-- Do not mark uncertain badges as owned.
			warn(
				"[BadgeChain] Ownership check failed for badge "
					.. tostring(badge.id)
					.. ": "
					.. tostring(hasBadge)
			)
		end
	end

	return false, ownedInBatch
end

--============================================================
-- TELEPORT RETRY HELPER
--============================================================
local function teleportUntilLeaving(player, placeId, teleportOptions, label)
	while player.Parent do
		local success, err = pcall(function()
			TeleportService:TeleportAsync(
				placeId,
				{ player },
				teleportOptions
			)
		end)

		if not success then
			warn(
				"[BadgeChain] "
					.. label
					.. " teleport failed: "
					.. tostring(err)
			)
		end

		-- Retry pacing applies only when the player remains here.
		task.wait(2.5)
	end
end

--============================================================
-- MAIN PLAYER FLOW
--============================================================
local function processPlayer(player)
	-- Event-based waiting avoids waking every 0.5 seconds just to check.
	if not listLoaded then
		listLoadedEvent.Event:Wait()
	end

	if not player.Parent then
		return
	end

	local gui = createGui(player)

	if not gui then
		return
	end

	setPhase(gui, "Waiting...", "Loading game data...")

	local currentUniverse = game.GameId
	local currentPlace = game.PlaceId
	local currentIndex = nil

	for i, entry in ipairs(gameList) do
		if entry.universeId == currentUniverse then
			currentIndex = i
			break
		end
	end

	local nextPlaceId = (
		currentIndex and currentIndex < #gameList
	) and gameList[currentIndex + 1].placeId or nil

	gui.gameTracker.Text = string.format(
		"Game %d of %d",
		currentIndex or 1,
		#gameList > 0 and #gameList or 1
	)

	local dsKey = "User_" .. player.UserId .. "_Universe_" .. currentUniverse

	-- Recover cached ownership from the previous server.
	local alreadyAwarded = {}

	local joinData = player:GetJoinData()
	local teleportData = joinData and joinData.TeleportData or {}

	if type(teleportData.awardedIds) == "table" then
		for _, id in ipairs(teleportData.awardedIds) do
			alreadyAwarded[tostring(id)] = true
		end
	end

	-- Merge the persistent cache with the teleport cache.
	local persistentCache = loadCache(dsKey)

	for id in pairs(persistentCache) do
		alreadyAwarded[id] = true
	end

	setPhase(gui, "Loading badges...", "Loading chain data...")

	local badges = fetchBadgesForUniverse(currentUniverse)

	-- Automatically rejoin if fetching badge data fails.
	if not badges then
		for seconds = 5, 1, -1 do
			if not player.Parent then
				return
			end

			setPhase(
				gui,
				"Error",
				string.format("Failed to load badges. Rejoining in %d...", seconds)
			)

			task.wait(1)
		end

		if not player.Parent then
			return
		end

		setPhase(gui, "Error", "Failed to load badges. Rejoining...")

		local teleportOptions = Instance.new("TeleportOptions")

		teleportUntilLeaving(
			player,
			currentPlace,
			teleportOptions,
			"Rejoin"
		)

		return
	end

	--========================================================
	-- BUILD THE LIST OF BADGES THAT STILL NEED AWARDING
	--========================================================
	local toAward = {}
	local ownedCount = 0
	local total = #badges
	local unchecked = {}

	for _, badge in ipairs(badges) do
		if alreadyAwarded[tostring(badge.id)] then
			ownedCount += 1
		else
			table.insert(unchecked, badge)
		end
	end

	setPhase(gui, "Checking badges...", "Syncing inventory...")

	-- Check at most 100 badge IDs per ownership request.
	for firstIndex = 1, #unchecked, BADGE_CHECK_BATCH_SIZE do
		if not player.Parent then
			return
		end

		local batchBadges = {}
		local lastIndex = math.min(
			firstIndex + BADGE_CHECK_BATCH_SIZE - 1,
			#unchecked
		)

		for i = firstIndex, lastIndex do
			table.insert(batchBadges, unchecked[i])
		end

		local _, ownedInBatch = checkBadgeBatch(
			player,
			batchBadges,
			alreadyAwarded
		)

		for _, badge in ipairs(batchBadges) do
			local key = tostring(badge.id)

			if ownedInBatch[key] then
				if not alreadyAwarded[key] then
					alreadyAwarded[key] = true
					ownedCount += 1
				end
			else
				table.insert(toAward, badge)
			end
		end

		-- One progress update per batch instead of per badge.
		updateProgress(gui, ownedCount, total)
	end

	--========================================================
	-- AWARD BADGES
	--========================================================
	local awardAttemptsThisServer = 0

	for index, badge in ipairs(toAward) do
		if not player.Parent then
			return
		end

		-- Count every request, not just successful awards.
		-- This prevents failed requests from exceeding the existing cap.
		awardAttemptsThisServer += 1

		local success, result = pcall(function()
			return BadgeService:AwardBadgeAsync(
				player.UserId,
				badge.id
			)
		end)

		if success and result == true then
			ownedCount += 1
			alreadyAwarded[tostring(badge.id)] = true

			setPhase(
				gui,
				"Awarding badges...",
				"Awarded Badge: " .. tostring(badge.id)
			)

		elseif success and result == false then
			-- Already owned or otherwise not newly awarded.
			-- Preserve the original script's handling of a false result.
			ownedCount += 1
			alreadyAwarded[tostring(badge.id)] = true

		else
			if isRateLimitError(result) then
				warn(
					"[BadgeChain] Rate limited while awarding badge "
						.. tostring(badge.id)
						.. ": "
						.. tostring(result)
				)
			else
				warn(
					"[BadgeChain] Error awarding badge "
						.. tostring(badge.id)
						.. ": "
						.. tostring(result)
				)
			end
		end

		-- Refresh the UI in groups of five to reduce GUI churn.
		if ownedCount % 5 == 0 or index == #toAward then
			updateProgress(gui, ownedCount, total)
		end

		-- Switch servers before exceeding the configured request cap.
		if awardAttemptsThisServer >= AWARDS_PER_SERVER
			and index < #toAward then

			setPhase(
				gui,
				"Switching servers...",
				"85 badge requests attempted. Moving to a fresh server..."
			)

			saveCache(dsKey, alreadyAwarded)

			local teleportOptions = Instance.new("TeleportOptions")
			teleportOptions.ShouldReserveServer = true
			teleportOptions:SetTeleportData(
				makeTeleportData(alreadyAwarded)
			)

			teleportUntilLeaving(
				player,
				currentPlace,
				teleportOptions,
				"Server-hop"
			)

			return
		end
	end

	-- Display the actual confirmed count instead of forcing a false 100%.
	updateProgress(gui, ownedCount, total)

	saveCache(dsKey, alreadyAwarded)

	--========================================================
	-- COMPLETION SOUND
	--========================================================
	local completeSound = Instance.new("Sound")
	completeSound.SoundId = "rbxassetid://107978604605265"
	completeSound.Volume = 0.69
	completeSound.PlaybackSpeed = 0.5
	completeSound.Parent = gui.screen
	completeSound:Play()

	--========================================================
	-- MOVE TO THE NEXT EXPERIENCE
	--========================================================
	if nextPlaceId then
		if ownedCount >= total then
			setPhase(
				gui,
				"Awarded all badges in this game!",
				"Teleporting to the next..."
			)
		else
			setPhase(
				gui,
				"Continuing chain...",
				string.format(
					"%d badges were not confirmed.",
					math.max(0, total - ownedCount)
				)
			)
		end

		local teleportOptions = Instance.new("TeleportOptions")
		teleportOptions:SetTeleportData({
			fromChain = true
		})

		teleportUntilLeaving(
			player,
			nextPlaceId,
			teleportOptions,
			"Next-game"
		)
	else
		if ownedCount >= total then
			setPhase(
				gui,
				"Come back tomorrow for more badges!",
				"Chain complete!"
			)

			gui.remainingBadges.Text = "All badges awarded in every game!"
		else
			setPhase(
				gui,
				"Chain ended with some failures.",
				string.format(
					"%d badges were not confirmed.",
					math.max(0, total - ownedCount)
				)
			)
		end
	end
end

--============================================================
-- PLAYER CONNECTIONS
--============================================================
Players.PlayerAdded:Connect(function(player)
	task.spawn(processPlayer, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(processPlayer, player)
end
